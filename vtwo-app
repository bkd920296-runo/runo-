/* ---------- voice input ---------- */
let heard = "", partial = "", listening = false, busy = false, rec = null;
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
const canListen = !!SR;
function startListening(){
  rec = new SR();
  rec.lang = S.src === "auto" ? (navigator.language || "en-US") : (speechCode(S.src) || "en-US");
  rec.interimResults = true; rec.continuous = false;
  heard = ""; partial = "";
  rec.onstart = () => { listening = true; micUI("listening"); };
  rec.onresult = e => {
    let f = "", p = "";
    for (let i = 0; i < e.results.length; i++) { const r = e.results[i]; if (r.isFinal) f += r[0].transcript; else p += r[0].transcript; }
    heard = f; partial = p; renderLive();
  };
  rec.onerror = e => {
    const m = {"not-allowed":"Microphone access is blocked. Allow it in your browser settings, or type instead.", "service-not-allowed":"Microphone access is blocked. Allow it in your browser settings, or type instead.",
      "no-speech":"I did not hear anything. Tap the microphone and try again.", "language-not-supported":"Voice input for " + lname(S.src) + " is not supported here. Type instead.", "network":"Voice input needs an internet connection."};
    if (e.error !== "aborted") toast(m[e.error] || "Voice input stopped.");
  };
  rec.onend = () => { listening = false; const t = (heard + " " + partial).trim(); heard = ""; partial = ""; micUI("idle"); if (t) translate(t); };
  rec.start();
}

/* ---------- toast ---------- */
let toastTimer;
function toast(msg){
  clearTimeout(toastTimer);
  $("toastHost").innerHTML = '<div class="toast" role="status">' + esc(msg) + "</div>";
  toastTimer = setTimeout(() => $("toastHost").innerHTML = "", 3200);
}

/* ---------- thread ---------- */
const turns = [];
function renderThread(){
  const el = $("thread");
  let h = "";
  if (!turns.length && !listening && !heard && !partial && !busy) {
    h = '<div class="empty"><h2>Speak. Hear it in any language.</h2><p>Tap the microphone, or try one of these.</p><div class="chips">' +
      EXAMPLES.map(t => '<button class="chip" data-ex="' + esc(t) + '">' + esc(t) + "</button>").join("") + "</div></div>";
  }
  turns.forEach((t, i) => {
    h += '<article class="turn"><div class="orig"><i>' + esc(t.from) + "</i>" + esc(t.text) + "</div>" +
      '<p class="tr" lang="' + esc(speechCode(t.tgt)) + '">' + esc(t.out) + "</p>" +
      (t.pron ? '<p class="pron">' + esc(t.pron) + "</p>" : "") +
      '<div class="acts"><button class="chip" data-speak="' + i + '"><svg viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4zM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg>Listen</button>' +
      '<button class="chip" data-copy="' + i + '"><svg viewBox="0 0 24 24"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></svg>Copy</button></div></article>';
  });
  h += '<div id="live"></div>';
  el.innerHTML = h;
  renderLive();
  el.scrollTop = el.scrollHeight;
}
function renderLive(){
  const l = $("live"); if (!l) return;
  if (busy) l.innerHTML = '<div class="live"><b>Translating…</b></div>';
  else if (listening || heard || partial) l.innerHTML = '<div class="live"><b>Listening…</b> ' + esc((heard + " " + partial).trim()) + "</div>";
  else l.innerHTML = "";
  $("thread").scrollTop = $("thread").scrollHeight;
}
$("thread").addEventListener("click", e => {
  const b = e.target.closest("button"); if (!b) return;
  if (b.dataset.ex) translate(b.dataset.ex);
  else if (b.dataset.speak != null) speak(turns[+b.dataset.speak].out, turns[+b.dataset.speak].tgt);
  else if (b.dataset.copy != null) copy(turns[+b.dataset.copy].out);
});
function copy(t){
  (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject()).then(() => toast("Copied"), () => toast("Press and hold the text to copy it"));
}
function speak(text, code){
  if (!("speechSynthesis" in window)) return toast("This browser cannot read text aloud.");
  const u = new SpeechSynthesisUtterance(text);
  const sc = speechCode(code);
  if (sc) {
    u.lang = sc;
    const v = speechSynthesis.getVoices();
    if (v.length && !v.some(x => x.lang.toLowerCase().startsWith(sc.slice(0,2).toLowerCase()))) toast("No " + lname(code) + " voice on this device. Reading with the default voice.");
  }
  speechSynthesis.cancel(); speechSynthesis.speak(u);
}

/* ---------- translate ---------- */
async function translate(text){
  text = text.trim(); if (!text || busy) return;
  busy = true; renderThread();
  try {
    const res = await fetch("/api/translate", {method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({text, source: S.src === "auto" ? null : lname(S.src), target: lname(S.tgt)})});
    if (!res.ok) { const err = new Error("http"); err.status = res.status; throw err; }
    const r = await res.json();
    const out = String(r.translation || "").trim();
    if (!out) throw new Error("empty");
    const t = {text, out, pron: String(r.pronunciation || "").trim(), from: String(r.detected || lname(S.src)), tgt: S.tgt};
    turns.push(t);
    const u = usageToday(); u.n++;
    if (S.settings.saveHistory) { S.history.unshift({id: Date.now(), ts: Date.now(), text, out, from: t.from, tgt: S.tgt}); S.history = S.history.slice(0, 200); }
    save();
    busy = false; renderThread();
    if (S.settings.autoSpeak) speak(out, S.tgt);
  } catch(e) {
    busy = false; renderThread();
    toast(e && e.status === 429 ? "Too many requests. Wait a moment and try again." : e && e.status === 413 ? "That text is too long. Try a shorter sentence." : !navigator.onLine ? "You are offline. Connect to the internet to translate." : "Could not translate that. Try again.");
  }
}

/* ---------- mic + typing ---------- */
function micUI(state){
  const b = $("micBtn");
  b.classList.toggle("on", state === "listening");
  $("micLabel").textContent = state === "starting" ? "Starting…" : state === "listening" ? "Listening… tap to stop" : state === "finishing" ? "Finishing…" : "Tap to speak";
  renderThread();
}
$("micBtn").addEventListener("click", () => {
  if (!canListen) { S.settings.typeBar = true; syncTypebar(true); toast("Voice input is not supported in this browser. Type instead, or use Chrome."); return; }
