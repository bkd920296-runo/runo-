/* ---------- analysis sheet ---------- */
function lastDays(n){
  const out = [];
  for (let i = n-1; i >= 0; i--) { const d = new Date(); d.setDate(d.getDate() - i); out.push({key: dayKey(d), label: d.toLocaleDateString(undefined, {weekday:"short"}).slice(0,3), today: i === 0}); }
  return out;
}
function openStats(){
  const real = Object.values(S.usage).some(u => u.n > 0 || u.secs >= 60);
  const days = lastDays(7);
  const SAMPLE_N = [4,7,3,9,6,11,5], SAMPLE_M = [6,12,5,15,9,18,8];
  const nums = days.map((d,i) => real ? (S.usage[d.key]?.n || 0) : SAMPLE_N[i]);
  const mins = days.map((d,i) => real ? Math.round((S.usage[d.key]?.secs || 0) / 60) : SAMPLE_M[i]);
  const pairs = {}; (real ? S.history : []).forEach(h => { pairs[h.tgt] = (pairs[h.tgt] || 0) + 1; });
  const top = Object.entries(pairs).sort((a,b) => b[1]-a[1])[0];
  const topName = real ? (top ? lname(top[0]) : "None yet") : "Nepali";
  function bars(arr, unit){
    const mx = Math.max(1, ...arr);
    return '<div class="bars">' + arr.map(v => '<div class="bar"><em>' + v + '</em><i class="' + (v ? "" : "zero") + '" style="height:' + Math.max(3, Math.round(v / mx * 80)) + 'px" title="' + v + " " + unit + '"></i></div>').join("") + '</div><div class="days">' +
      days.map(d => '<span class="' + (d.today ? "today" : "") + '">' + esc(d.label) + "</span>").join("") + "</div>";
  }
  openSheet("Daily analysis", (real ? "" : '<p class="note" style="margin:0 0 12px"><span class="badge" style="margin:0 6px 0 0">Example</span>Your own numbers replace these after you translate something.</p>') +
    '<div class="tiles"><div class="tile"><b>' + nums[6] + '</b><small>Today</small></div><div class="tile"><b>' + (real ? Math.round(usageToday().secs / 60) : mins[6]) + '<span style="font-size:13px"> min</span></b><small>Time spent</small></div><div class="tile"><b>' + esc(topName) + '</b><small>Top language</small></div></div>' +
    '<div class="chart"><h3>Translations per day</h3>' + bars(nums, "translations") + "</div>" +
    '<div class="chart"><h3>Minutes spent per day</h3>' + bars(mins, "minutes") + "</div>" +
    '<button class="btn ghost" id="toHist" style="width:100%">Open history</button>', el => { el.querySelector("#toHist").addEventListener("click", () => { closeSheet(el); openHistory(); }); });
}
