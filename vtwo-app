  openSheet("Privacy", '<div class="group"><h3>On this device</h3>' + toggleRow("saveHistory", "Save history", "Keep translations in History on this device", S.settings.saveHistory) +
    toggleRow("autoSpeak", "Read translations aloud", "Speak each result automatically", S.settings.autoSpeak) + "</div>" +
    '<div class="group"><h3>Your data</h3><button class="btn danger" id="wipe" style="width:100%">Delete history and analysis</button></div>' +
    '<p class="note">Voice is turned into text by your browser speech service when you tap the microphone. Text you translate is sent to the Vtwo server and translated with Claude. History and analysis stay only on this device.</p>', el => {
    wireToggles(el);
    const w = el.querySelector("#wipe");
    w.addEventListener("click", () => {
      if (w.dataset.sure) { S.history = []; S.usage = {}; save(); turns.length = 0; renderThread(); toast("History and analysis deleted"); closeSheet(el); }
      else { w.dataset.sure = "1"; w.textContent = "Tap again to delete everything"; }
    });
  });
}
function openAccount(){
  const signed = isSignedIn();
  const nameHtml = '<div class="group"><h3>Profile</h3><input class="field" id="acName" placeholder="Your name" value="' + esc(S.settings.name) + '" maxlength="40" aria-label="Your name"></div>';
  let authHtml = "";
  if (signed) {
    let detail = "";
    if (S.auth.provider === "Phone") detail = "Phone · " + esc(S.auth.phone);
    else detail = esc(S.auth.provider) + " · " + esc(S.auth.email || "");
    const pic = S.auth.picture ? '<img src="' + esc(S.auth.picture) + '" alt="" style="width:32px;height:32px;border-radius:50%">' : '';
    authHtml = '<div class="group"><h3>Signed in</h3>' +
      '<div class="row" style="border-radius:12px">' + pic + '<span class="t">' + esc(S.auth.name || S.auth.provider) + '<small>' + detail + '</small></span></div>' +
      '<div style="margin-top:12px"><button class="btn danger" id="signOutBtn" style="width:100%">Sign out</button></div></div>';
  } else {
    authHtml = '<div class="group"><h3>Sign in</h3>' +
      '<button class="row" data-auth="google" style="gap:14px"><span style="display:grid;place-items:center;width:24px;height:24px">' +
        '<svg viewBox="0 0 48 48" width="22" height="22" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>' +
        '</span><span class="t">Google<small>Sign in with your Google account</small></span>' + chev + "</button>" +
      '<button class="row" data-auth="gmail" style="gap:14px"><span style="display:grid;place-items:center;width:24px;height:24px">' +
        '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>' +
        '</span><span class="t">Gmail<small>Use your Gmail address</small></span>' + chev + "</button>" +
      '<button class="row" data-auth="phone" style="gap:14px"><span style="display:grid;place-items:center;width:24px;height:24px">' +
        '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>' +
        '</span><span class="t">Phone number<small>Sign in with a mobile number</small></span>' + chev + "</button></div>";
  }
  openSheet("Account", nameHtml + authHtml +
    '<div class="group"><h3>Defaults</h3><button class="row" id="acLang"><span class="t">Translate to<small>' + esc(lname(S.tgt)) + "</small></span>" + chev + "</button></div>" +
    '<p class="note">Your name and settings stay in this browser. Google Sign-In uses real OAuth when a Client ID is configured.</p>', el => {
    el.querySelector("#acName").addEventListener("input", e => { S.settings.name = e.target.value; save(); });
    el.querySelector("#acLang").addEventListener("click", () => openLang("tgt"));
    const so = el.querySelector("#signOutBtn");
    if (so) so.addEventListener("click", () => { signOut(); openAccount(); });
    el.addEventListener("click", e => {
      const b = e.target.closest("[data-auth]"); if (!b) return;
      const m = b.dataset.auth;
      if (m === "google") signInWithGoogle();
      else if (m === "gmail") signInWithGmail();
      else if (m === "phone") { closeSheet(el); openPhoneAuth(); }
    });
  });
}
function openHistory(){
  const rows = S.history.map(h => '<div class="hist"><div class="o">' + esc(h.from) + ": " + esc(h.text) + '</div><div class="n">' + esc(h.out) + '</div><div class="m"><span>' + esc(lname(h.tgt)) + " · " + new Date(h.ts).toLocaleString(undefined, {month:"short", day:"numeric", hour:"numeric", minute:"2-digit"}) +
    '</span><span><button data-hl="' + h.id + '">Listen</button><button data-hd="' + h.id + '">Delete</button></span></div></div>').join("");
  openSheet("History", rows || '<p class="note">Nothing here yet. Translations you make are saved on this device' + (S.settings.saveHistory ? "." : ", once History is turned on in Privacy."), el => {
    el.addEventListener("click", e => {
      const l = e.target.closest("[data-hl]"), d = e.target.closest("[data-hd]");
      if (l) { const h = S.history.find(x => x.id == l.dataset.hl); if (h) speak(h.out, h.tgt); }
      if (d) { S.history = S.history.filter(x => x.id != d.dataset.hd); save(); closeSheet(el); openHistory(); }
    });
  });
}

/* ---------- time spent ---------- */
let tick = 0;
setInterval(() => { if (document.visibilityState === "visible") { usageToday().secs++; if (++tick % 15 === 0) save(); } }, 1000);
addEventListener("pagehide", save);
document.addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") save(); });

/* ---------- Google Identity Services ready ---------- */
window.addEventListener("load", () => {
  if (window.google && window.google.accounts && window.google.accounts.id) {
    googleReady = true;
  } else {
    // GIS may still be loading; poll briefly
    let tries = 0;
    const iv = setInterval(() => {
      if (window.google && window.google.accounts && window.google.accounts.id) { googleReady = true; clearInterval(iv); }
      else if (++tries > 20) clearInterval(iv);
    }, 200);
  }
  if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(() => {});
});

/* ---------- init ---------- */
syncPair(); renderThread(); syncTypebar();
</script>
