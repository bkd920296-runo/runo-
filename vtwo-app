fj|Fijian|Na Vosa Vakaviti`;
const LANGS = LANG_SRC.split("\n").map(l => { const [code, name, native] = l.split("|"); return {code, name, native}; });
const byCode = Object.fromEntries(LANGS.map(l => [l.code, l]));
const EXAMPLES = ["Where is the nearest hospital?", "How much does this cost?", "I would like a table for two.", "Thank you for your help."];

/* ---------- state + storage ---------- */
const K = "vtwo.v2";
const defaults = {
  src:"auto", tgt:"ne",
  settings:{saveHistory:true, autoSpeak:false, typeBar:false, name:""},
  auth:{signedIn:false, provider:null, email:null, phone:null, name:null, picture:null},
  history:[], usage:{}
};
let S = structuredClone(defaults);
try { const raw = localStorage.getItem(K); if (raw) S = deepMerge(structuredClone(defaults), JSON.parse(raw)); } catch(e){}
function deepMerge(a,b){ for(const k in b){ if(b[k] && typeof b[k]==="object" && !Array.isArray(b[k])){ a[k]=deepMerge(a[k]||{},b[k]); } else a[k]=b[k]; } return a; }
function save(){ try { localStorage.setItem(K, JSON.stringify(S)); } catch(e){} }
const dayKey = (d = new Date()) => d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0");
function usageToday(){ return (S.usage[dayKey()] ||= {n:0, secs:0}); }

function lname(code){
  if (code === "auto") return "Detect language";
  if (code.startsWith("x:")) return code.slice(2);
  return byCode[code] ? byCode[code].name : code;
}
