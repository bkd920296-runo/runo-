<style>
:root{
  --bg:#EEF1F6; --surface:#FFFFFF; --surface2:#E3E8F0; --fg:#101626; --muted:#566077; --line:#D2D9E5;
  --accent:#0A8C87; --on-accent:#FFFFFF; --danger:#C62F3B; --shadow:rgba(16,22,38,.14);
  --display:'Space Grotesk','Inter',system-ui,sans-serif; --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0B1016; --surface:#141B24; --surface2:#1D2631; --fg:#EAF0F7; --muted:#8B97AA; --line:#263140;
  --accent:#3EE0C8; --on-accent:#06201C; --danger:#FF7A85; --shadow:rgba(0,0,0,.5); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0B1016; --surface:#141B24; --surface2:#1D2631; --fg:#EAF0F7; --muted:#8B97AA; --line:#263140;
  --accent:#3EE0C8; --on-accent:#06201C; --danger:#FF7A85; --shadow:rgba(0,0,0,.5); color-scheme:dark}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--body);font-size:15px;line-height:1.45;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  -webkit-tap-highlight-color:transparent;overscroll-behavior:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.app{max-width:480px;height:100%;margin:0 auto;display:flex;flex-direction:column;position:relative}
.top{display:flex;align-items:center;justify-content:space-between;padding:12px 0 8px}
.brand{display:flex;align-items:center;gap:10px}
.brand svg{width:38px;height:38px;display:block}
.brand b{font-family:var(--display);font-size:22px;letter-spacing:-.02em}
.iconbtn{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:var(--surface);border:1px solid var(--line)}
.iconbtn svg{width:22px;height:22px;stroke:var(--fg);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.pair{display:flex;align-items:center;gap:8px;margin:4px 0 10px}
.pair button{flex:1;min-width:0;text-align:left;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px 12px}
.pair small{display:block;color:var(--muted);font-size:11px;letter-spacing:.06em;text-transform:uppercase}
.pair span{display:block;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pair .swap{flex:0 0 40px;height:40px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line);background:var(--surface2);padding:0}
.pair .swap svg{width:18px;height:18px;stroke:var(--fg);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.thread{flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:12px;padding:4px 0 12px;-webkit-overflow-scrolling:touch}
.turn{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px 14px 10px}
.turn .orig{color:var(--muted);font-size:13px;overflow-wrap:anywhere}
.turn .orig i{font-style:normal;font-size:11px;letter-spacing:.06em;text-transform:uppercase;margin-right:6px}
.turn .tr{font-family:var(--display);font-weight:500;font-size:22px;line-height:1.3;margin:8px 0 2px;overflow-wrap:anywhere}
.turn .pron{color:var(--accent);font-size:14px;margin:0 0 4px;overflow-wrap:anywhere}
.turn .acts{display:flex;gap:6px;margin-top:6px}
.chip{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:999px;border:1px solid var(--line);background:var(--surface2);font-size:13px;font-weight:500}
.chip svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.live{border:1px dashed var(--accent);border-radius:16px;padding:14px;color:var(--muted)}
.live b{color:var(--accent);font-weight:600}
.empty{margin:auto 0;padding:12px 4px}
.empty h2{font-family:var(--display);font-size:26px;line-height:1.2;letter-spacing:-.02em;margin:0 0 6px;text-wrap:balance}
.empty p{margin:0 0 14px;color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chips .chip{height:auto;min-height:36px;padding:6px 12px;text-align:left}
.typebar{display:flex;gap:8px;margin-bottom:10px}
.typebar input{flex:1;min-width:0;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--fg);padding:0 14px;font:inherit}
.typebar button{height:44px;padding:0 16px;border-radius:12px;background:var(--accent);color:var(--on-accent);font-weight:600}
.dock{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:8px 0 14px;gap:12px}
.dock .side{width:64px;height:64px;border-radius:16px;background:var(--surface);border:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:11px;font-weight:600}
.dock .side svg{width:24px;height:24px;stroke:var(--fg);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.dock .l{justify-self:start}.dock .r{justify-self:end}
.mic{display:flex;flex-direction:column;align-items:center;gap:6px}
.mic button{width:88px;height:88px;border-radius:50%;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;box-shadow:0 8px 24px var(--shadow);position:relative}
.mic button svg{width:36px;height:36px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.mic button.on::after{content:"";position:absolute;inset:-8px;border-radius:50%;border:2px solid var(--accent);animation:pulse 1.2s ease-out infinite}
@keyframes pulse{from{transform:scale(.9);opacity:.9}to{transform:scale(1.25);opacity:0}}
@media (prefers-reduced-motion:reduce){.mic button.on::after{animation:none}}
.mic span{font-size:12px;font-weight:600;color:var(--muted);min-height:18px}
.sheet{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;justify-content:center;background:rgba(5,8,14,.55)}
.panel{width:100%;max-width:480px;max-height:92%;height:92%;background:var(--bg);border-radius:20px 20px 0 0;display:flex;flex-direction:column;
  padding:0 max(16px,env(safe-area-inset-left,0px)) env(safe-area-inset-bottom,0px) max(16px,env(safe-area-inset-right,0px));animation:up .22s ease-out}
@keyframes up{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
@media (prefers-reduced-motion:reduce){.panel{animation:none}}
.phead{display:flex;align-items:center;gap:8px;padding:14px 0 10px}
.phead h2{flex:1;margin:0;font-family:var(--display);font-size:20px;letter-spacing:-.01em}
.pbody{flex:1;min-height:0;overflow-y:auto;padding-bottom:16px;-webkit-overflow-scrolling:touch}
.group{margin:0 0 16px}
.group>h3{margin:0 0 6px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.row{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:14px;background:var(--surface);border:1px solid var(--line);margin-top:-1px;min-height:52px}
.group .row:first-of-type{border-radius:12px 12px 0 0;margin-top:0}
.group .row:last-child{border-radius:0 0 12px 12px}
.group .row:only-of-type{border-radius:12px}
.row .t{flex:1;min-width:0}
.row .t small{display:block;color:var(--muted);font-size:12.5px}
.row svg.chev{width:18px;height:18px;stroke:var(--muted);fill:none;stroke-width:2}
.tog{width:46px;height:28px;border-radius:999px;background:var(--surface2);border:1px solid var(--line);position:relative;flex:0 0 46px}
.tog::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:var(--muted);transition:transform .15s}
.tog[aria-checked="true"]{background:var(--accent);border-color:var(--accent)}
.tog[aria-checked="true"]::after{transform:translateX(18px);background:var(--on-accent)}
.btn{height:44px;padding:0 16px;border-radius:12px;background:var(--accent);color:var(--on-accent);font-weight:600}
.btn.ghost{background:var(--surface);color:var(--fg);border:1px solid var(--line)}
.btn.danger{background:var(--surface);color:var(--danger);border:1px solid var(--danger)}
.btn.google{background:#fff;color:#3c4043;border:1px solid #dadce0;display:inline-flex;align-items:center;justify-content:center;gap:10px}
.field{width:100%;height:46px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--fg);padding:0 14px;font:inherit}
textarea.field{height:120px;padding:12px 14px;resize:none}
.note{color:var(--muted);font-size:13px;margin:8px 2px 0}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:var(--surface2);padding:4px;border-radius:12px;margin-bottom:10px}
.seg button{height:38px;border-radius:9px;font-weight:600;font-size:13.5px;color:var(--muted)}
.seg button[aria-selected="true"]{background:var(--surface);color:var(--fg);box-shadow:0 1px 3px var(--shadow)}
.lang{display:flex;justify-content:space-between;align-items:center;gap:10px;width:100%;text-align:left;padding:12px 4px;border-bottom:1px solid var(--line)}
.lang small{color:var(--muted)}
.lang[aria-current="true"]{color:var(--accent);font-weight:600}
.lang[aria-current="true"]::after{content:"Selected";font-size:12px}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:16px}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 12px;min-width:0}
.tile b{display:block;font-family:var(--display);font-size:24px;line-height:1.1;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tile small{color:var(--muted);font-size:12px}
.chart{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 12px 8px;margin-bottom:16px}
.chart h3{margin:0 0 10px;font-size:13px;font-weight:600}
.bars{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;align-items:end;height:110px}
.bar{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;gap:4px;min-width:0}
.bar i{display:block;width:100%;max-width:30px;border-radius:6px 6px 2px 2px;background:var(--accent);min-height:3px}
.bar i.zero{background:var(--line)}
.bar em{font-style:normal;font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
.days{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-top:4px}
.days span{text-align:center;font-size:11px;color:var(--muted)}
.days span.today{color:var(--fg);font-weight:700}
.badge{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--surface2);color:var(--muted);margin-left:6px;vertical-align:middle}
.hist{padding:12px 0;border-bottom:1px solid var(--line)}
.hist .o{color:var(--muted);font-size:13px;overflow-wrap:anywhere}
.hist .n{font-weight:600;overflow-wrap:anywhere}
.hist .m{display:flex;justify-content:space-between;align-items:center;margin-top:4px;font-size:12px;color:var(--muted)}
.hist .m button{color:var(--accent);font-weight:600;font-size:13px;padding:6px}
.toast{position:fixed;left:50%;bottom:calc(120px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:40;background:var(--fg);color:var(--bg);
  padding:10px 16px;border-radius:12px;font-size:14px;max-width:min(440px,calc(100% - 32px));text-align:center;box-shadow:0 6px 20px var(--shadow)}
[hidden]{display:none!important}
body{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
</style>
</head>
<body>

<div class="app" id="app">
  <header class="top">
    <div class="brand">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="16" fill="var(--surface)" stroke="var(--line)"/>
        <path d="M13 14 L32 52 L51 14" fill="none" stroke="var(--accent)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path id="two" d="M24 27 C24 15 45 15 45 27 C45 35 31 40 25 51 L47 51" stroke="var(--surface)" stroke-width="11"/>
          <path d="M24 27 C24 15 45 15 45 27 C45 35 31 40 25 51 L47 51" stroke="var(--fg)" stroke-width="5"/>
        </g>
      </svg>
      <b>Vtwo</b>
    </div>
    <button class="iconbtn" id="menuBtn" aria-label="Menu"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  </header>

  <div class="pair">
    <button id="srcBtn"><small>From</small><span id="srcName">Detect language</span></button>
    <button class="swap" id="swapBtn" aria-label="Swap languages"><svg viewBox="0 0 24 24"><path d="M7 4 3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"/></svg></button>
    <button id="tgtBtn"><small>To</small><span id="tgtName">Nepali</span></button>
  </div>

  <main class="thread" id="thread" aria-live="polite"></main>

  <form class="typebar" id="typebar" hidden>
    <input id="typeInput" type="text" placeholder="Type to translate" autocomplete="off" enterkeyhint="send">
    <button type="submit">Translate</button>
  </form>

  <nav class="dock">
    <button class="side l" id="statsBtn" aria-label="Daily analysis">
      <svg viewBox="0 0 24 24"><path d="M3 20h18M6 16V11M11 16V6M16 16v-4M21 16V9"/></svg>Analysis
    </button>
    <div class="mic">
      <button id="micBtn" aria-label="Tap to speak">
        <svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
      </button>
      <span id="micLabel">Tap to speak</span>
    </div>
    <button class="side r" id="langBtn" aria-label="Language">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>Language
    </button>
  </nav>
</div>
<div id="layer"></div>
<div id="toastHost"></div>

<script>
"use strict";
/* ---------- data ---------- */
const LANG_SRC = `en|English|English
