/* ---------- sheets ---------- */
const stack = [];
function openSheet(title, bodyHtml, onMount){
  const el = document.createElement("div");
  el.className = "sheet";
  el.innerHTML = '<section class="panel" role="dialog" aria-modal="true" aria-label="' + esc(title) + '"><div class="phead"><h2>' + esc(title) +
    '</h2><button class="iconbtn" data-close aria-label="Close"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div><div class="pbody">' + bodyHtml + "</div></section>";
  $("layer").appendChild(el); stack.push(el);
  el.addEventListener("click", e => { if (e.target === el || e.target.closest("[data-close]")) closeSheet(el); });
  if (onMount) onMount(el);
  return el;
}
function closeSheet(el){ el = el || stack[stack.length-1]; if (!el) return; el.remove(); const i = stack.indexOf(el); if (i > -1) stack.splice(i,1); }
function closeAllSheets(){ stack.slice().forEach(closeSheet); }
document.addEventListener("keydown", e => { if (e.key === "Escape") closeSheet(); });
