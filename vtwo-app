  }
  // Fallback: demo mode (no real auth)
  S.auth = { signedIn:true, provider:"Google", email:"user@gmail.com", name:S.settings.name || "Google user", picture:null, phone:null };
  save(); toast("Demo sign-in with Google"); closeAllSheets(); openAccount();
}
